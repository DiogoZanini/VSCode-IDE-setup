{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compile + CS50", // referencing the cs50.c library for compilation
            "command": "C:\\mingw64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "C:\\mingw64\\lib\\cs50.c", // path to the cs50 library file
                "-I", "C:\\mingw64\\include", // libraries include path
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        },
